<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Passport – Learn what you want, from someone near you</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#F3F8F6;--surf:#fff;--ink:#0E2A2B;--mute:#52696A;--line:#D5E3DF;--teal:#0F8B78;--teal2:#0A5F54;--gold:#F2B33D;--coral:#FF7A5C;--hero:#0B3B3A;--herotxt:#EAF6F2;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#081918;--surf:#0F2625;--ink:#E7F4F0;--mute:#93B0AB;--line:#1D3A38;--teal:#2BC4A9;--teal2:#2BC4A9;--hero:#06201F}}
:root[data-theme="dark"]{--bg:#081918;--surf:#0F2625;--ink:#E7F4F0;--mute:#93B0AB;--line:#1D3A38;--teal:#2BC4A9;--teal2:#2BC4A9;--hero:#06201F}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{background:var(--bg);color:var(--ink);font:400 16px/1.6 "DM Sans",system-ui,sans-serif;overflow-x:hidden}
h1,h2,h3{font-family:"Bricolage Grotesque","DM Sans",sans-serif;line-height:1.08;letter-spacing:-.02em}
a{color:inherit;text-decoration:none}
button{font:inherit;cursor:pointer;border:0;color:inherit;background:none}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.wrap{max-width:1120px;margin:auto;padding:0 20px}
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:color-mix(in srgb,var(--bg) 85%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{font:800 22px "Bricolage Grotesque",sans-serif;display:flex;gap:8px;align-items:center}
.logo i{width:28px;height:28px;border-radius:50%;background:conic-gradient(var(--gold),var(--coral),var(--teal),var(--gold));display:inline-block}
.links{display:flex;gap:22px;align-items:center;font-weight:500;color:var(--mute)}
.btn{padding:11px 20px;border-radius:99px;font-weight:700;transition:transform .15s,box-shadow .15s}
.btn:hover{transform:translateY(-2px)}
.pri{background:var(--gold);color:#2B1D00;box-shadow:0 6px 18px -6px #F2B33Daa}
.ghost{border:1.5px solid var(--line);background:var(--surf)}
@media(max-width:720px){.links a{display:none}}
/* hero */
.hero{background:radial-gradient(900px 500px at 80% 10%,#17635A66,transparent),var(--hero);color:var(--herotxt);overflow:hidden;position:relative}
.hero .wrap{display:grid;grid-template-columns:1.05fr .95fr;gap:30px;align-items:center;padding-top:56px;padding-bottom:72px;min-height:620px}
.hero h1{font-size:clamp(38px,6vw,68px);font-weight:800}
.hero p.sub{margin:18px 0 26px;font-size:18px;color:#B7D6CF;max-width:46ch}
.sbox{display:flex;gap:8px;background:#fff;border-radius:99px;padding:7px;max-width:560px;box-shadow:0 20px 50px -20px #000a}
.sbox input{flex:1;border:0;outline:0;padding:0 16px;font:inherit;color:#0E2A2B;background:none;min-width:0}
.hint{margin-top:14px;display:flex;gap:8px;flex-wrap:wrap}
.chip{padding:6px 14px;border-radius:99px;border:1px solid #ffffff30;color:#CFE8E1;font-size:14px;background:#ffffff10}
.chip:hover{background:#ffffff25}
.stage{perspective:1100px;height:440px;position:relative}
.book{position:absolute;inset:0;margin:auto;width:250px;height:340px;transform-style:preserve-3d;transform:rotateY(-24deg) rotateX(8deg);transition:transform .15s ease-out;animation:float 6s ease-in-out infinite}
@keyframes float{50%{translate:0 -14px}}
.face{position:absolute;inset:0;border-radius:10px 18px 18px 10px;background:linear-gradient(145deg,#12806F,#073C37);border:1px solid #ffffff30;box-shadow:0 40px 60px -20px #000c;padding:26px;display:flex;flex-direction:column;justify-content:space-between;color:#F6E3B2}
.face b{font:800 30px "Bricolage Grotesque";letter-spacing:.02em}
.seal{width:110px;height:110px;border-radius:50%;margin:auto;border:3px double #F2B33D;display:grid;place-items:center;font-size:44px;background:radial-gradient(#F2B33D22,transparent)}
.edge{position:absolute;top:0;left:0;width:34px;height:100%;background:#052e2a;transform:rotateY(-90deg) translateZ(17px);transform-origin:left}
.pin{position:absolute;background:var(--surf);color:var(--ink);padding:10px 14px;border-radius:14px;font-size:14px;box-shadow:0 18px 30px -12px #000a;transform:translateZ(90px);display:flex;gap:8px;align-items:center;white-space:nowrap}
.pin small{color:var(--mute);display:block;line-height:1.2}
.p1{left:-90px;top:30px;animation:float 5s -1s ease-in-out infinite}
.p2{right:-70px;top:150px;animation:float 5.5s -2s ease-in-out infinite}
.p3{left:-50px;bottom:20px;animation:float 6.5s -3s ease-in-out infinite}
.dot{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#E3F5F0;font-size:18px}
@media(max-width:860px){.hero .wrap{grid-template-columns:1fr}.stage{height:380px;order:-1;margin-top:-10px}.p1{left:0}.p2{right:0}.p3{left:10px}.book{scale:.85}}
/* sections */
section{padding:84px 0}
h2{font-size:clamp(30px,4.4vw,46px);font-weight:800;max-width:18ch}
.lead{color:var(--mute);max-width:56ch;margin-top:12px;font-size:18px}
.steps{display:grid;grid-template-columns:repeat(4,1fr);margin-top:40px;position:relative}
.steps:before{content:"";position:absolute;top:27px;left:6%;right:6%;border-top:2px dashed var(--line)}
.step{text-align:center;padding:0 10px;position:relative}
.step span{width:54px;height:54px;border-radius:50%;background:var(--surf);border:2px solid var(--teal);display:grid;place-items:center;margin:0 auto 14px;font-size:24px}
.step h3{font-size:19px}.step p{color:var(--mute);font-size:15px;margin-top:6px}
@media(max-width:720px){.steps{grid-template-columns:1fr 1fr;gap:28px 0}.steps:before{display:none}}
/* demo */
.demo{background:var(--surf);border:1px solid var(--line);border-radius:28px;margin-top:34px;display:grid;grid-template-columns:290px 1fr;overflow:hidden;box-shadow:0 30px 60px -40px #0b3b3a88}
.side{padding:24px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:18px;background:color-mix(in srgb,var(--bg) 60%,var(--surf))}
.side label{font-weight:700;display:flex;justify-content:space-between;font-size:15px}
.side output{color:var(--teal2)}
input[type=range]{width:100%;accent-color:var(--teal)}
select{width:100%;padding:10px;border-radius:12px;border:1px solid var(--line);background:var(--surf);color:var(--ink);font:inherit}
.cats{display:flex;flex-wrap:wrap;gap:7px}
.cat{padding:7px 13px;border-radius:99px;border:1.5px solid var(--line);background:var(--surf);font-size:14px;font-weight:500}
.cat[aria-pressed=true]{background:var(--teal);border-color:var(--teal);color:#fff}
.res{padding:24px;min-height:420px}
.res>header{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px}
.card{display:grid;grid-template-columns:62px 1fr auto;gap:16px;align-items:center;padding:16px;border:1px solid var(--line);border-radius:20px;margin-bottom:12px;background:var(--surf);transition:transform .2s,border-color .2s}
.card:hover{transform:translateX(4px);border-color:var(--teal)}
.av{width:62px;height:62px;border-radius:50%;display:grid;place-items:center;font:800 24px "Bricolage Grotesque";color:#fff}
.card h3{font-size:18px;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.tag{font:500 12px "DM Sans";padding:2px 9px;border-radius:99px;background:#DDF3EC;color:#0A5F54}
.why{font-size:13px;color:var(--teal2);margin-top:4px}
.meta{display:flex;gap:14px;flex-wrap:wrap;color:var(--mute);font-size:14px}
.price{font:800 22px "Bricolage Grotesque";text-align:right}
.price small{display:block;font:400 12px "DM Sans";color:var(--mute)}
.price .btn{margin-top:6px;padding:8px 16px;background:var(--teal);color:#fff;font-size:14px}
.empty{text-align:center;padding:60px 10px;color:var(--mute)}
@media(max-width:820px){.demo{grid-template-columns:1fr}.side{border-right:0;border-bottom:1px solid var(--line)}.card{grid-template-columns:52px 1fr}.price{grid-column:1/-1;text-align:left;display:flex;align-items:center;justify-content:space-between}.av{width:52px;height:52px}}
/* trust + freelancer */
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:34px}
.tile{background:var(--surf);border:1px solid var(--line);border-radius:22px;padding:24px}
.tile i{font-style:normal;font-size:28px;display:block;margin-bottom:10px}
.tile h3{font-size:20px}.tile p{color:var(--mute);margin-top:6px;font-size:15px}
@media(max-width:820px){.grid3{grid-template-columns:1fr}}
.teach{background:var(--hero);color:var(--herotxt);border-radius:32px;padding:48px;display:grid;grid-template-columns:1.2fr .8fr;gap:30px;align-items:center}
.teach p{color:#B7D6CF;margin:12px 0 22px;max-width:48ch}
.earn{background:#ffffff12;border:1px solid #ffffff25;border-radius:22px;padding:22px}
.earn div{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #ffffff18}
.earn div:last-child{border:0;font-weight:700;color:var(--gold)}
@media(max-width:820px){.teach{grid-template-columns:1fr;padding:30px}}
footer{padding:34px 0 50px;color:var(--mute);font-size:14px;border-top:1px solid var(--line)}
/* modal + toast */
dialog{border:0;border-radius:24px;padding:28px;width:min(420px,92vw);background:var(--surf);color:var(--ink);margin:auto;box-shadow:0 40px 80px -20px #000b}
dialog::backdrop{background:#041412aa;backdrop-filter:blur(4px)}
dialog[open]{animation:pop .25s ease-out}
@keyframes pop{from{scale:.94;opacity:0}}
.slots{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0}
.slot{padding:10px;border:1.5px solid var(--line);border-radius:12px;font-weight:500}
.slot[aria-pressed=true]{border-color:var(--teal);background:#DDF3EC;color:#0A5F54}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));translate:-50% 140%;background:var(--ink);color:var(--bg);padding:14px 22px;border-radius:99px;font-weight:500;transition:translate .35s cubic-bezier(.3,1.4,.5,1);z-index:50}
.toast.on{translate:-50% 0}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}html{scroll-behavior:auto}}
</style>
</head>
<body>
<nav><div class="wrap">
  <a class="logo" href="#top"><i></i>Passport</a>
  <div class="links"><a href="#how">How it works</a><a href="#find">Find someone</a><a href="#trust">Trust</a><a href="#teach">Teach</a>
  <a class="btn pri" href="#find">Get started</a></div>
</div></nav>

<header class="hero" id="top"><div class="wrap">
  <div>
    <h1>Learn what you want, from someone near you.</h1>
    <p class="sub">Find verified local coaches, artists and tutors. Compare price, distance and ratings, then book in a minute.</p>
    <form class="sbox" id="hs">
      <input id="q" aria-label="What do you want to learn" placeholder="Try: guitar teacher under ₹500 within 5 km">
      <button class="btn pri" type="submit">Search</button>
    </form>
    <div class="hint" id="hints"></div>
  </div>
  <div class="stage" id="stage">
    <div class="book" id="book">
      <div class="edge"></div>
      <div class="face"><b>PASSPORT</b><div class="seal">🧭</div><span>Skills · Near you</span></div>
      <div class="pin p1"><span class="dot">🎸</span><div>Arun · 2.1 km<small>₹400 · 4.9 ★</small></div></div>
      <div class="pin p2"><span class="dot">🏸</span><div>Divya · 1.4 km<small>₹350 · 4.8 ★</small></div></div>
      <div class="pin p3"><span class="dot">📷</span><div>Karthik · 3.0 km<small>₹600 · 4.7 ★</small></div></div>
    </div>
  </div>
</div></header>

<section id="how"><div class="wrap">
  <h2>From “I want to learn” to booked, in four steps</h2>
  <p class="lead">No more asking around on WhatsApp or scrolling Instagram to find a trainer you can trust.</p>
  <div class="steps">
    <div class="step"><span>🔎</span><h3>Search</h3><p>Type what you want in plain words.</p></div>
    <div class="step"><span>✨</span><h3>Get matched</h3><p>We rank people by fit, not just stars.</p></div>
    <div class="step"><span>📅</span><h3>Book</h3><p>Pick a slot that suits you.</p></div>
    <div class="step"><span>⭐</span><h3>Review</h3><p>Rate the session after it’s done.</p></div>
  </div>
</div></section>

<section id="find" style="padding-top:0"><div class="wrap">
  <h2>Try it. Everyone here is a sample.</h2>
  <p class="lead">Change a filter and the list updates instantly. Sample profiles only, not real Passport users.</p>
  <div class="demo">
    <aside class="side">
      <div><label>Skill</label><div class="cats" id="cats" style="margin-top:8px"></div></div>
      <div><label>Distance <output id="od"></output></label><input type="range" id="d" min="1" max="12" value="5"></div>
      <div><label>Budget per session <output id="op"></output></label><input type="range" id="p" min="200" max="1000" step="50" value="600"></div>
      <div><label>Minimum rating</label><select id="r"><option value="0">Any</option><option value="4">4.0 and above</option><option value="4.5">4.5 and above</option></select></div>
      <div><label>Sort by</label><select id="s"><option value="match">Best match</option><option value="distance">Nearest</option><option value="price">Lowest price</option><option value="rating">Top rated</option></select></div>
    </aside>
    <div class="res"><header><h3 id="count"></h3><span class="tag" id="nl" hidden></span></header><div id="list"></div></div>
  </div>
</div></section>

<section id="trust" style="padding-top:0"><div class="wrap">
  <h2>Built so you can trust who you book</h2>
  <div class="grid3">
    <div class="tile"><i>🪪</i><h3>Verified identity</h3><p>Freelancers can verify through an authorised provider and earn a badge on their profile.</p></div>
    <div class="tile"><i>🧾</i><h3>Reviews that are real</h3><p>Only learners with a completed booking can review, and reviews can’t be quietly rewritten.</p></div>
    <div class="tile"><i>🔒</i><h3>Safe payments</h3><p>Pay through the app. Clear cancellation and refund rules apply to every booking.</p></div>
  </div>
</div></section>

<section id="teach" style="padding-top:0"><div class="wrap"><div class="teach">
  <div><h2 style="color:#fff">Good at something? Get paid for it.</h2>
  <p>List your skills, set your price and your hours, and let nearby learners find you.</p>
  <a class="btn pri" href="#find">Become a freelancer</a></div>
  <div class="earn" aria-label="Example earnings">
    <div><span>25 sessions</span><span>₹10,000</span></div>
    <div><span>Platform commission 15%</span><span>−₹1,500</span></div>
    <div><span>You receive</span><span>₹8,500</span></div>
  </div>
</div></div></section>

<footer><div class="wrap">Passport · Learn. Teach. Earn. Locally. · Concept prototype with sample data.</div></footer>

<dialog id="dlg"><h3 id="dt" style="font-size:24px"></h3><p id="ds" style="color:var(--mute)"></p>
  <div class="slots" id="slots"></div>
  <div style="display:flex;gap:10px;justify-content:flex-end"><button class="btn ghost" id="cx">Cancel</button><button class="btn pri" id="ok" disabled>Confirm booking</button></div>
</dialog>
<div class="toast" id="toast" role="status"></div>

<script>
var P=[
{n:"Arun",s:"Guitar",d:2.1,p:400,r:4.9,v:1,l:"Beginners",c:"#0F8B78",t:"Weekends"},
{n:"Meera",s:"Guitar",d:3.5,p:300,r:4.7,v:1,l:"Beginners",c:"#E0662E",t:"Weekends"},
{n:"Rahul",s:"Guitar",d:8,p:700,r:4.8,v:1,l:"Advanced",c:"#5B5BD6",t:"Weekdays"},
{n:"Divya",s:"Badminton",d:1.4,p:350,r:4.8,v:1,l:"All levels",c:"#C2410C",t:"Evenings"},
{n:"Suresh",s:"Badminton",d:4.6,p:500,r:4.5,v:1,l:"Kids",c:"#0E7490",t:"Weekends"},
{n:"Karthik",s:"Photography",d:3,p:600,r:4.7,v:1,l:"Beginners",c:"#7C3AED",t:"Weekends"},
{n:"Nisha",s:"Photography",d:1.5,p:550,r:4.6,v:0,l:"Intermediate",c:"#BE185D",t:"Evenings"},
{n:"Anitha",s:"Yoga",d:2.4,p:300,r:4.9,v:1,l:"Beginners",c:"#15803D",t:"Mornings"},
{n:"Vikram",s:"Coding",d:5.2,p:450,r:4.8,v:1,l:"Python basics",c:"#1D4ED8",t:"Weekends"},
{n:"Lakshmi",s:"Pottery",d:6.8,p:800,r:4.9,v:1,l:"Workshop",c:"#B45309",t:"Weekends"}];
var CATS=["All","Guitar","Badminton","Photography","Yoga","Coding","Pottery"];
var SL=["Sat 9:00 AM","Sat 11:00 AM","Sun 10:00 AM","Sun 4:00 PM"];
var $=function(i){return document.getElementById(i)},st={c:"All",nl:""},pick=null,slot=null;
function chips(){$("cats").innerHTML=CATS.map(function(c){return '<button class="cat" aria-pressed="'+(c===st.c)+'" data-c="'+c+'">'+c+'</button>'}).join("")}
function score(x){var d=Math.max(0,1-x.d/12),pr=Math.max(0,1-x.p/1000);return Math.round(100*(.4*(x.r-3)/2+.25*d+.2*pr+.15*x.v))}
function render(){
 var D=+$("d").value,B=+$("p").value,R=+$("r").value,S=$("s").value;
 $("od").textContent=D+" km";$("op").textContent="₹"+B;
 var a=P.filter(function(x){return(st.c==="All"||x.s===st.c)&&x.d<=D&&x.p<=B&&x.r>=R});
 a.forEach(function(x){x.m=score(x)});
 a.sort(function(x,y){return S==="distance"?x.d-y.d:S==="price"?x.p-y.p:S==="rating"?y.r-x.r:y.m-x.m});
 $("count").textContent=a.length+(a.length===1?" person":" people")+" near you";
 $("list").innerHTML=a.length?a.map(function(x,i){return '<div class="card"><div class="av" style="background:'+x.c+'">'+x.n[0]+'</div><div><h3>'+x.n+' <span class="tag">'+x.s+'</span>'+(x.v?'<span class="tag">Verified</span>':'')+'</h3><div class="meta"><span>★ '+x.r+'</span><span>'+x.d+' km</span><span>'+x.l+'</span><span>'+x.t+'</span></div>'+(S==="match"&&i===0?'<div class="why">Top pick: close by, well rated and within your budget.</div>':'')+'</div><div class="price">₹'+x.p+'<small>per session</small><button class="btn" data-b="'+P.indexOf(x)+'">Book</button></div></div>'}).join(""):'<div class="empty"><div style="font-size:40px">🧭</div><p>No one matches yet. Try a wider distance or a higher budget.</p></div>';
}
$("cats").onclick=function(e){var c=e.target.dataset.c;if(c){st.c=c;chips();render()}};
["d","p","r","s"].forEach(function(i){$(i).oninput=render});
$("list").onclick=function(e){var b=e.target.dataset.b;if(b==null)return;pick=P[b];slot=null;
 $("dt").textContent="Book "+pick.n;$("ds").textContent=pick.s+" · ₹"+pick.p+" per session · "+pick.d+" km away";
 $("slots").innerHTML=SL.map(function(s){return '<button class="slot" aria-pressed="false">'+s+'</button>'}).join("");$("ok").disabled=true;$("dlg").showModal()};
$("slots").onclick=function(e){if(!e.target.classList.contains("slot"))return;slot=e.target.textContent;
 [].forEach.call($("slots").children,function(b){b.setAttribute("aria-pressed",b===e.target)});$("ok").disabled=false};
$("cx").onclick=function(){$("dlg").close()};
$("ok").onclick=function(){$("dlg").close();toast("Booked "+pick.n+" for "+slot+". They’ll confirm shortly.")};
function toast(m){var t=$("toast");t.textContent=m;t.classList.add("on");setTimeout(function(){t.classList.remove("on")},3200)}
/* natural-language search */
var SY={Guitar:["guitar","music"],Badminton:["badminton","shuttle"],Photography:["photo","camera"],Yoga:["yoga","fitness"],Coding:["code","coding","python","programming"],Pottery:["pottery","clay"]};
function nl(q){q=q.toLowerCase();var c="All",f=[];
 Object.keys(SY).forEach(function(k){if(SY[k].some(function(w){return q.indexOf(w)>-1}))c=k});
 var m=q.match(/(?:under|below|less than)\s*₹?\s*(\d{3,4})/);if(m){$("p").value=Math.min(1000,Math.max(200,+m[1]));f.push("under ₹"+m[1])}
 m=q.match(/(?:within|under)\s*(\d+)\s*km/);if(m){$("d").value=Math.min(12,Math.max(1,+m[1]));f.push("within "+m[1]+" km")}
 st.c=c;chips();render();var n=$("nl");n.hidden=false;n.textContent="Understood: "+(c==="All"?"any skill":c)+(f.length?", "+f.join(", "):"");
 $("find").scrollIntoView({behavior:"smooth"})}
$("hs").onsubmit=function(e){e.preventDefault();nl($("q").value||"guitar")};
$("hints").innerHTML=["guitar under ₹500 within 5 km","badminton coach","yoga for beginners","python tutor"].map(function(h){return '<button class="chip" type="button">'+h+'</button>'}).join("");
$("hints").onclick=function(e){if(e.target.classList.contains("chip")){$("q").value=e.target.textContent;nl(e.target.textContent)}};
/* 3D tilt */
var stg=$("stage"),bk=$("book");
stg.onmousemove=function(e){var r=stg.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;bk.style.transform="rotateY("+(-24+x*40)+"deg) rotateX("+(8-y*30)+"deg)"};
stg.onmouseleave=function(){bk.style.transform="rotateY(-24deg) rotateX(8deg)"};
chips();render();
</script>
</body>
</html>
